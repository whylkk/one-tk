[Script]
One1-Bootstrap = type=http-response, pattern=^https?://[^/]+/v2\.5/bootstrap, script-path=https://raw.githubusercontent.com/whylkk/one-tk/main/one1.js, requires-body=true, max-size=2097152, timeout=30
One1-VipDL = type=http-response, pattern=^https?://[^/]+/v2\.5/vip/download, script-path=https://raw.githubusercontent.com/whylkk/one-tk/main/one1.js, requires-body=true, max-size=2097152, timeout=30
One1-Detail = type=http-response, pattern=^https?://[^/]+/v2\.5/article/detail, script-path=https://raw.githubusercontent.com/whylkk/one-tk/main/one1.js, requires-body=true, max-size=2097152, timeout=30
One1-List = type=http-response, pattern=^https?://[^/]+/v2\.5/article/(day|discovery|search|list), script-path=https://raw.githubusercontent.com/whylkk/one-tk/main/one1.js, requires-body=true, max-size=2097152, timeout=30
One1-Series = type=http-response, pattern=^https?://[^/]+/v2\.5/series/(list|chapters), script-path=https://raw.githubusercontent.com/whylkk/one-tk/main/one1.js, requires-body=true, max-size=2097152, timeout=30

[URL Rewrite]
^https?://.*/v2\.5/ad/space reject

[MITM]
hostname = %APPEND% api.*, *.einhn4.com, *.em1oifd0.com, *.xqjby.com, *.scycjz.com, 38.46.10.*, 202.95.22.*, 198.44.248.*, 122.10.20.249
